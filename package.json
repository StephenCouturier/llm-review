{
	"name": "llm-review",
	"version": "0.1.0",
	"description": "Review your branch diff in a pi TUI, leave threaded line comments, and dispatch them to the agent to fix",
	"license": "MIT",
	"author": "Stephen Couturier",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/StephenCouturier/llm-review.git"
	},
	"keywords": ["pi-package", "pi", "code-review", "tui", "git"],
	"type": "module",
	"files": ["extensions/**/*.ts", "README.md", "LICENSE"],
	"pi": {
		"extensions": ["./extensions/llm-review"]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
